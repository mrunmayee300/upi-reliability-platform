# UPI Platform — Environment template (copy to .env for local dev)

# Kafka
KAFKA_BROKERS=localhost:9092

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=upi
POSTGRES_PASSWORD=upi_dev_password
POSTGRES_DB=upi_platform

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=upi-service

# API Gateway
API_KEYS=dev-api-key-001,dev-api-key-002
RATE_LIMIT_RPS=1000

# Retry Orchestrator
MAX_RETRY_ATTEMPTS=5
RETRY_INITIAL_INTERVAL=1s
RETRY_MAX_INTERVAL=60s

# Bank Simulator defaults
BANK_DEFAULT_FAILURE_RATE=0.05
BANK_DEFAULT_LATENCY_MS=120

# AI Prediction
AI_MODEL_PATH=./services/ai-prediction/models/congestion_xgb.json
PREDICTION_INTERVAL_SECONDS=60

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8089/v1/ws/live
